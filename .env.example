# Copia de referencia: los valores reales van SOLO en Vercel
# (Project > Settings > Environment Variables). Nunca en el codigo.

# Token de acceso del negocio (permisos instagram_basic e instagram_manage_comments)
INSTAGRAM_ACCESS_TOKEN=""
# ID de la cuenta de Instagram del negocio (no es el @handle)
INSTAGRAM_BUSINESS_ID=""
# @handle del negocio, sin la arroba. Ej: clinicasol
INSTAGRAM_HANDLE=""

# App de Meta: secreto para verificar la firma de los avisos
META_APP_SECRET=""
# Palabra que tu inventas y escribes igual en Meta > Webhooks > Verify token
META_VERIFY_TOKEN=""

# Opcional (default v23.0)
GRAPH_API_VERSION=""

# Tabla de canjes en produccion. Se prueba primero Supabase; si no esta
# configurado, se usa Upstash; si tampoco, se usa memoria (se borra en
# cada llamada de Vercel).

# Supabase (3.21): Project Settings > API Keys.
# OJO: SUPABASE_SERVICE_ROLE_KEY, no la publishable/anon. Esto corre
# solo del lado del servidor (api/verify-tag.py), nunca en el frontend.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Alternativa (si no usas Supabase): Upstash Redis.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
